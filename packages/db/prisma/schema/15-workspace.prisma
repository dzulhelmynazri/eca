enum IntegrationProvider {
  TELEGRAM
  TWILIO
}

model Workspace {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  ownerUserId         String
  ownerUser           User                 @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  customerOwnerUserId String?
  customerOwnerUser   User?                @relation("WorkspaceCustomerOwner", fields: [customerOwnerUserId], references: [id], onDelete: SetNull)
  integrations        WorkspaceIntegration[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([ownerUserId])
  @@index([customerOwnerUserId])
  @@map("workspace")
}

model WorkspaceIntegration {
  id              String              @id @default(cuid())
  workspaceId     String
  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider        IntegrationProvider
  encryptedConfig String
  createdByUserId String
  createdByUser   User                @relation("WorkspaceIntegrationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  updatedByUserId String
  updatedByUser   User                @relation("WorkspaceIntegrationUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([workspaceId, provider])
  @@index([provider])
  @@map("workspace_integration")
}
