# Local development auth for Vercel AI Gateway.
AI_GATEWAY_API_KEY=

# Optional fallback used by some AI Gateway SDK integrations on Vercel.
VERCEL_OIDC_TOKEN=

# Better Auth config used by `agent/lib/auth.ts` session lookup.
# openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001

# Required by Better Auth session/database reads.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional if you use Google OAuth sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encryption key for tenant integration credentials.
# openssl rand -hex 32
INTEGRATIONS_ENCRYPTION_KEY=

# Display name used by Chat SDK channels and outbound sender name.
AGENT_DISPLAY_NAME="Use Forever"

# Redis state adapter URL for Chat SDK channels.
REDIS_URL=

# Telegram channel credentials are configured from the web app Settings page.

# Discord channel credentials.
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=

# WhatsApp channel credentials.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Resend channel credentials.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_ADDRESS=

# Messenger channel credentials.
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=

# Twilio channel credentials are configured from the web app Settings page.

# Upstash Redis REST credentials for agentkit extension.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=