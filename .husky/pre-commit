#!/bin/sh
# Check if there are any staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED_FILES" ]; then
  echo "No staged files to check"
  exit 0
fi

# Run formatter on staged files first so lint sees formatted code
FORMAT_TARGETS=$(echo "$STAGED_FILES" | rg -N '\.(js|jsx|ts|tsx|mjs|cjs|json|jsonc|md|mdx|css|scss|yml|yaml)$' || true)
FORMAT_EXIT_CODE=0
if [ -n "$FORMAT_TARGETS" ]; then
  # Avoid xargs for portability in restricted environments.
  bun x oxfmt --write $FORMAT_TARGETS || FORMAT_EXIT_CODE=$?
fi

# Re-stage files that were already staged
echo "$STAGED_FILES" | while IFS= read -r file; do
  if [ -f "$file" ]; then
    git add -- "$file"
  fi
done

if [ $FORMAT_EXIT_CODE -ne 0 ]; then
  echo "oxfmt failed to format files."
  exit $FORMAT_EXIT_CODE
fi

# Lint staged source files
LINT_TARGETS=$(echo "$STAGED_FILES" | rg -N '\.(js|jsx|ts|tsx|mjs|cjs)$' || true)
LINT_EXIT_CODE=0
if [ -n "$LINT_TARGETS" ]; then
  # Avoid xargs for portability in restricted environments.
  bun x oxlint $LINT_TARGETS || LINT_EXIT_CODE=$?
fi

if [ $LINT_EXIT_CODE -ne 0 ]; then
  echo "oxlint found issues."
  exit $LINT_EXIT_CODE
fi

echo "✨ Files checked by oxfmt + oxlint"
